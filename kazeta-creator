def xxh3sum(path):
    result = subprocess.run(["xxh3sum", path], capture_output=True, text=True)
    return result.stdout[5:21]

def xxh3_check(path, expected):
    actual = xxh3sum(path)
    if actual != expected:
        print("ERROR: xxh3sum mismatch: {}".format(os.path.basename(path)))
        print("Expect: {}".format(expected))
        print("Actual: {}".format(actual))
        return False
    return True



