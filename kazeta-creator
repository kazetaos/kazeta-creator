#
# Classic Mac (HFS) disc images, which 7z can't read (it only knows HFS+). Each file's data fork is
# written under its name, a non-empty resource fork next to it as `<name>.rsrc`, the raw fork that
# ScummVM's MacResManager reads. The image can start with an Apple partition map (CDs) or with the
# volume itself (floppies). '/' in Mac names becomes ':', as macOS shows it
def extract_hfs(path, out_dir):
    import struct
    with open(path, 'rb') as f:
        img = f.read()
    base = 0
    if img[512:514] == b'PM':
        for i in range(1, struct.unpack('>I', img[516:520])[0] + 1):
            entry = img[i * 512:(i + 1) * 512]
            if entry[48:80].split(b'\0')[0] == b'Apple_HFS':
                base = struct.unpack('>I', entry[8:12])[0] * 512
                break
    mdb = img[base + 1024:base + 1024 + 162]
    if mdb[:2] != b'BD':
        sys.exit("ERROR: {} is not an HFS image".format(os.path.basename(path)))
    block_size = struct.unpack('>I', mdb[20:24])[0]
    first_block = base + struct.unpack('>H', mdb[28:30])[0] * 512

    def extents(rec):
        return [struct.unpack('>HH', rec[i:i + 4]) for i in range(0, 12, 4)]

    def read_fork(exts, length, file_id=None, fork=0):
        data = bytearray()
        exts = list(exts)
        i = 0
        while len(data) < length:
            if i == len(exts):  # the rest is in the extents overflow file
                more = overflow.get((fork, file_id, sum(n for _, n in exts)))
                if more is None:
                    sys.exit("ERROR: missing extents in {}".format(os.path.basename(path)))
                exts += more
            start, count = exts[i]
            i += 1
            offset = first_block + start * block_size
            data += img[offset:offset + count * block_size]
        return bytes(data[:length])

    def leaves(exts, length):
        tree = read_fork(exts, length)
        node_size = struct.unpack('>H', tree[32:34])[0]
        node = struct.unpack('>I', tree[24:28])[0]  # first leaf
        while node:
            n = tree[node * node_size:(node + 1) * node_size]
            for r in range(struct.unpack('>H', n[10:12])[0]):
                start = struct.unpack('>H', n[node_size - 2 * (r + 1):node_size - 2 * r])[0]
                key_len = n[start]
                data = start + 1 + key_len
                yield n[start + 1:data], n[data + data % 2:]  # records start at an even offset
            node = struct.unpack('>I', n[0:4])[0]

    overflow = {}
    for key, rec in leaves(extents(mdb[134:146]), struct.unpack('>I', mdb[130:134])[0]):
        fork, file_id, start = struct.unpack('>BIH', key[0:7])
        overflow[(fork, file_id, start)] = extents(rec)

    dirs = {}
    files = []
    for key, rec in leaves(extents(mdb[150:162]), struct.unpack('>I', mdb[146:150])[0]):
        parent = struct.unpack('>I', key[1:5])[0]
        name = key[6:6 + key[5]].decode('mac_roman').replace('/', ':')
        if rec[0] == 1:
            dirs[struct.unpack('>I', rec[6:10])[0]] = (parent, name)
        elif rec[0] == 2:
            files.append((parent, name, rec))

    def dir_path(dir_id):
        if dir_id == 2:  # the root folder, named after the volume
            return ''
        parent, name = dirs[dir_id]
        return os.path.join(dir_path(parent), name)

    for dir_id in dirs:
        os.makedirs(os.path.join(out_dir, dir_path(dir_id)), exist_ok=True)
    for parent, name, rec in files:
        file_id = struct.unpack('>I', rec[20:24])[0]
        target = os.path.join(out_dir, dir_path(parent), name)
        with open(target, 'wb') as f:
            f.write(read_fork(extents(rec[74:86]), struct.unpack('>I', rec[26:30])[0], file_id, 0))
        rsrc_len = struct.unpack('>I', rec[36:40])[0]
        if rsrc_len:
            with open(target + '.rsrc', 'wb') as f:
                f.write(read_fork(extents(rec[86:98]), rsrc_len, file_id, 0xff))


#
# MSI packages, installed from their tables instead of with msiexec (which would run in Wine and write
# the build machine's hardware into the registry). Files go to the prefix, registry values to a
# registry layer of the cart (see the windows-3.0 runtime), directories added to PATH to the cart's
# WINEPATH (Wine adds it to PATH; the registry's PATH stays the runtime's). Anything else a package would do (custom
# actions that run code, COM registration, services, ...) stops the build, unless the recipe names the
# component or action in `skip`
#

# the standard folders, as in a 64-bit Wine prefix; 32-bit packages get the (x86) and syswow64 ones
MSI_FOLDERS = {
    'TARGETDIR': '', 'WindowsVolume': '', 'ROOTDRIVE': '',
    'ProgramFilesFolder': 'Program Files (x86)', 'ProgramFiles64Folder': 'Program Files',
    'CommonFilesFolder': 'Program Files (x86)/Common Files', 'CommonFiles64Folder': 'Program Files/Common Files',
    'WindowsFolder': 'windows', 'SystemFolder': 'windows/syswow64', 'System64Folder': 'windows/system32',
    'System16Folder': 'windows/system', 'FontsFolder': 'windows/Fonts',
    'CommonAppDataFolder': 'ProgramData', 'AppDataFolder': 'users/steamuser/AppData/Roaming',
    'LocalAppDataFolder': 'users/steamuser/AppData/Local', 'TempFolder': 'users/steamuser/AppData/Local/Temp',
    'PersonalFolder': 'users/steamuser/Documents', 'DesktopFolder': 'users/steamuser/Desktop',
    'ProgramMenuFolder': 'ProgramData/Microsoft/Windows/Start Menu/Programs',
    'StartMenuFolder': 'ProgramData/Microsoft/Windows/Start Menu',
    'StartupFolder': 'ProgramData/Microsoft/Windows/Start Menu/Programs/StartUp',
}
# the prefix's spelling of directories packages may write with another case
MSI_CASE = {n.lower(): n for n in ['windows', 'system32', 'syswow64', 'Fonts', 'Program Files',
                                   'Program Files (x86)', 'Common Files', 'ProgramData', 'users']}
# tables whose rows would do something this installer doesn't, for the components they name
MSI_UNSUPPORTED = ['IniFile', 'ServiceInstall', 'Class', 'TypeLib',
                   'ProgId', 'Extension', 'AppId', 'DuplicateFile', 'MoveFile', 'Font', 'PublishComponent',
                   'IsolatedComponent', 'MsiDriverPackages', 'ODBCDriver', 'ODBCDataSource', 'Complus']


class MsiDatabase:
    """the tables of an MSI database, from its streams as `7z -tCompound` extracts them"""
    def __init__(self, streams):
        self.streams = streams
        pool = self.read('!_StringPool')
        data = self.read('!_StringData')
        header = int.from_bytes(pool[0:4], 'little')
        codepage = header & 0xffff
        encoding = 'utf-8' if codepage == 65001 else 'cp%d' % (codepage or 1252)
        self.refsize = 3 if header & 0x80000000 else 2
        self.strings = ['']
        off, i = 0, 4
        while i + 4 <= len(pool):
            n, refs = int.from_bytes(pool[i:i + 2], 'little'), int.from_bytes(pool[i + 2:i + 4], 'little')
            i += 4
            if n == 0 and refs != 0: # longer than 64K: the length follows
                n = int.from_bytes(pool[i:i + 4], 'little')
                i += 4
            self.strings.append(data[off:off + n].decode(encoding))
            off += n
        self.columns = {}
        for table, number, name, coltype in self.rows_of('_Columns', 'sisi'):
            self.columns.setdefault(table, []).append((number, name, coltype))

    def read(self, name):
        path = os.path.join(self.streams, name)
        if not os.path.isfile(path):
            return b''
        with open(path, 'rb') as f:
            return f.read()

    def rows_of(self, table, kinds):
        """rows of a table stream, stored column by column; kinds: s (string) or i/I (2/4-byte int)"""
        data = self.read('!' + table)
        widths = [self.refsize if k == 's' else 2 if k == 'i' else 4 for k in kinds]
        if not data:
            return []
        n = len(data) // sum(widths)
        columns, off = [], 0
        for k, w in zip(kinds, widths):
            col = []
            for r in range(n):
                v = int.from_bytes(data[off + r * w:off + (r + 1) * w], 'little')
                if k == 's':
                    col.append(self.strings[v] if v else None)
                else:
                    col.append(v - (0x8000 if w == 2 else 0x80000000) if v else None)
            columns.append(col)
            off += n * w
        return list(zip(*columns))

    def table(self, name):
        """list of {column: value}"""
        cols = sorted(self.columns.get(name, []))
        kinds = ''.join('s' if t & 0x0800 else 'I' if (t & 0xff) == 4 else 'i' for _, _, t in cols)
        return [dict(zip([c[1] for c in cols], row)) for row in self.rows_of(name, kinds)]


def reg_escape(s):
    out = ''
    for c in s:
        if c in '\\"':
            out += '\\' + c
        elif c == '\0':
            out += '\\0'
        elif ord(c) < 32 or ord(c) > 126:
            out += '\\x%04x' % ord(c)
        else:
            out += c
    return out


def install_msi(path, source, cart_dir, work_dir, env):
    name = os.path.splitext(os.path.basename(path))[0]
    skip = source.get('skip', [])
    skip = skip if isinstance(skip, list) else [skip]
    def skipped(n):
        return any(fnmatch.fnmatchcase(n, s) for s in skip)
    def fail(message):
        print('ERROR: {}: {}'.format(os.path.basename(path), message))
        sys.exit(1)

    streams = os.path.join(work_dir, 'streams')
    subprocess.run(["7z", "x", "-y", "-bso0", "-bsp0", "-tCompound", "-o" + streams, path], check=True)
    db = MsiDatabase(streams)
    props = {r['Property']: r['Value'] or '' for r in db.table('Property')}

    # components of the chosen features (default: those installed by default)
    features = db.table('Feature')
    chosen = source.get('features')
    if chosen is None:
        chosen = [f['Feature'] for f in features if f['Level'] and 0 < f['Level'] <= int(props.get('INSTALLLEVEL', 1))]
    chosen = chosen if isinstance(chosen, list) else chosen.split()
    unknown = set(chosen) - {f['Feature'] for f in features}
    if unknown:
        fail('no feature {}'.format(', '.join(sorted(unknown))))
    components = {r['Component']: r for r in db.table('Component')}
    selected = []
    for r in db.table('FeatureComponents'):
        c = r['Component_']
        if r['Feature_'] in chosen and c not in selected and not skipped(c):
            selected.append(c)
    for c in selected:
        if components[c]['Condition']:
            fail('component {} has a condition ({}); skip it or its feature'.format(c, components[c]['Condition']))
    for t in MSI_UNSUPPORTED:
        for r in db.table(t):
            c = r.get('Component_') or r.get('Component')
            if c in selected:
                fail('component {} has {} entries, which aren\'t supported; skip it'.format(c, t))
    # .NET assemblies for the GAC go where `gac` says (relative to the cart root): wine-mono doesn't
    # look in the GAC an MSI installs into. Private assemblies (File_Application) install as files
    gac = {r['Component_'] for r in db.table('MsiAssembly') if r['Component_'] in selected and not r['File_Application']}
    if gac and 'gac' not in source:
        fail('components {} install .NET assemblies into the GAC; set `gac` or skip them'.format(', '.join(sorted(gac))))
    files = [f for f in db.table('File') if f['Component_'] in selected]
    selfreg = {r['File_'] for r in db.table('SelfReg')}
    for f in files:
        if f['File'] in selfreg:
            fail('file {} registers itself (SelfReg); skip component {}'.format(f['File'], f['Component_']))

    # directories, with what custom actions before CostFinalize set them to
    directories = {r['Directory']: r for r in db.table('Directory')}
    overrides = {}
    def directory(d, seen=()):
        """-> path in drive_c, '/'-separated"""
        if d in overrides:
            return overrides[d]
        if d in MSI_FOLDERS:
            return MSI_FOLDERS[d]
        if d not in directories or d in seen:
            fail('unknown directory {}'.format(d))
        r = directories[d]
        parent = directory(r['Directory_Parent'], seen + (d,)) if r['Directory_Parent'] and r['Directory_Parent'] != d else ''
        target = r['DefaultDir'].split(':')[0].split('|')[-1]
        return parent if target in ('.', 'SourceDir', 'SOURCEDIR') else (parent + '/' + target).strip('/')
    def winpath(p):
        return 'C:\\' + p.replace('/', '\\') + ('\\' if p else '')
    def fmt(value):
        """MSI formatted string: [Property], [Directory], [#file], [~], [\\x]"""
        def sub(m):
            key = m.group(1)
            if key == '~':
                return '\0'
            if key.startswith('\\'):
                return key[1:]
            if key[0] in '#!':
                f = next((f for f in files if f['File'] == key[1:]), None)
                if f is None:
                    fail('formatted string refers to {}, which isn\'t installed'.format(key))
                return winpath(directory(components[f['Component_']]['Directory_'])) + f['FileName'].split('|')[-1]
            if key in props:
                return props[key]
            if key in directories or key in MSI_FOLDERS or key in overrides:
                return winpath(directory(key))
            fail('formatted string refers to {}, which isn\'t supported'.format(key))
        return re.sub(r'\[([^\[\]]+)\]', sub, value or '')

    custom = {r['Action']: r for r in db.table('CustomAction')}
    sequence = sorted(db.table('InstallExecuteSequence'), key=lambda r: r['Sequence'] or 0)
    # DirectX's redistributable, run by an action as DXSETUP.exe (an installed file): installed here
    # as DXSETUP would, the DLLs from its cabinets into the system directories. Its own files (setup
    # program, cabinets) aren't installed
    dxsetup = []
    for step in sequence:
        a = step['Action']
        if a not in custom or skipped(a):
            continue
        base = custom[a]['Type'] & 0x3f
        if base == 19: # stops the install with an error message when its condition holds
            continue
        f = next((f for f in files if f['File'] == custom[a]['Source']), None)
        if base == 18 and f and f['FileName'].split('|')[-1].lower() == 'dxsetup.exe':
            dxsetup.append(f['Component_'])
            continue
        if base not in (35, 51):
            fail('custom action {} (type {}) runs code; check what it does and skip it'.format(a, custom[a]['Type']))
        if step['Condition']:
            fail('custom action {} has a condition ({}); skip it'.format(a, step['Condition']))
        value = fmt(custom[a]['Target'])
        target = custom[a]['Source']
        if base == 35 or target in directories:
            # a Windows path back to one in drive_c
            overrides[target] = value.replace('\\', '/').split(':', 1)[-1].strip('/')
        else:
            props[target] = value

    def cart_path(component, p):
        parts = [MSI_CASE.get(x.lower(), x) for x in p.split('/') if x]
        # 32-bit components see syswow64 as system32
        if not components[component]['Attributes'] & 0x100 and parts[:2] == ['windows', 'system32']:
            parts[1] = 'syswow64'
        return os.path.join(cart_dir, '.kazeta/var/prefix/drive_c', *parts)

    # files, from the cabinets they're stored in (named by their File key)
    cabs = os.path.join(work_dir, 'cabs')
    for m in db.table('Media'):
        cab = m['Cabinet']
        if not cab:
            continue
        cab_path = os.path.join(streams, cab[1:]) if cab.startswith('#') else os.path.join(os.path.dirname(path), cab)
        if not os.path.isfile(cab_path):
            fail('cabinet {} not found'.format(cab))
        subprocess.run(["7z", "x", "-y", "-bso0", "-bsp0", "-o" + cabs, cab_path], check=True)
    for f in files:
        src = os.path.join(cabs, f['File'])
        if not os.path.isfile(src):
            fail('file {} not found in the cabinets'.format(f['File']))
        if f['Component_'] in dxsetup:
            # its x86 cabinets go to syswow64, x64 ones to system32 (dxupdate.cab is DXSETUP's own)
            cab_name = f['FileName'].split('|')[-1].lower()
            arch = 'syswow64' if cab_name.endswith('_x86.cab') else 'system32' if cab_name.endswith('_x64.cab') else None
            if arch:
                dlls = os.path.join(work_dir, 'directx', cab_name)
                subprocess.run(["7z", "x", "-y", "-bso0", "-bsp0", "-o" + dlls, src, "*.dll"], check=True)
                sysdir = os.path.join(cart_dir, '.kazeta/var/prefix/drive_c/windows', arch)
                os.makedirs(sysdir, exist_ok=True)
                for dll in sorted(os.listdir(dlls)):
                    shutil.copyfile(os.path.join(dlls, dll), os.path.join(sysdir, dll.lower()))
            continue
        if f['Component_'] in gac:
            dst = os.path.normpath(os.path.join(cart_dir, str(source['gac'])))
        else:
            dst = cart_path(f['Component_'], directory(components[f['Component_']]['Directory_']))
        os.makedirs(dst, exist_ok=True)
        shutil.copyfile(src, os.path.join(dst, f['FileName'].split('|')[-1]))
    for r in db.table('CreateFolder'):
        if r['Component_'] in selected:
            os.makedirs(cart_path(r['Component_'], directory(r['Directory_'])), exist_ok=True)

    # directories added to PATH ([~] stands for its current value), for Wine's WINEPATH
    for r in db.table('Environment'):
        if r['Component_'] not in selected:
            continue
        var = r['Name'].lstrip('=+-!*')
        parts = fmt(r['Value']).split('\0')
        if var.upper() != 'PATH' or '!' in r['Name'][:-len(var)] or len(parts) != 2:
            fail('environment variable {} ({}) isn\'t supported; skip component {}'.format(r['Name'], r['Value'], r['Component_']))
        dirs = [d for d in (parts[0] + ';' + parts[1]).split(';') if d]
        env['WINEPATH'] = ';'.join([p for p in env.get('WINEPATH', '').split(';') if p] + dirs)

    # registry values, as a layer of the cart's registry
    hives = {}
    for r in db.table('Registry'):
        c = r['Component_']
        if c not in selected:
            continue
        root = r['Root']
        if root == -1:
            root = 2 if props.get('ALLUSERS') else 1
        key = fmt(r['Key']).strip('\\')
        wow64 = not components[c]['Attributes'] & 0x100
        if root == 0: # HKEY_CLASSES_ROOT
            key = 'Software\\Classes\\' + key
            root = 2
        if root == 2 and wow64 and key.lower().startswith('software\\') and not key.lower().startswith('software\\wow6432node'):
            # 32-bit components see Software\Wow6432Node; in Classes only the keys Windows redirects
            rest = key[len('software\\'):]
            if not rest.lower().startswith('classes\\'):
                key = 'Software\\Wow6432Node\\' + rest
            elif rest.split('\\')[1].lower() in ('clsid', 'interface', 'typelib', 'appid', 'directshow', 'media type', 'mediafoundation'):
                key = 'Software\\Classes\\Wow6432Node\\' + rest[len('classes\\'):]
        if root not in (1, 2):
            fail('registry root {} isn\'t supported'.format(r['Root']))
        values = hives.setdefault('user.reg' if root == 1 else 'system.reg', {}).setdefault(key, {})
        vname, raw = r['Name'], r['Value']
        if raw is None and vname in ('+', '-', '*'):
            continue # create the key (it is, with its values) or remove it when uninstalling
        if raw is None and vname is None:
            continue
        value = fmt(raw)
        if value.startswith('#x') or value.startswith('#X'):
            data = 'hex:' + ','.join(value[2 + i:4 + i].lower() for i in range(0, len(value) - 2, 2))
        elif value.startswith('#%'):
            data = 'str(2):"{}"'.format(reg_escape(value[2:]))
        elif value.startswith('##'):
            data = '"{}"'.format(reg_escape(value[1:]))
        elif value.startswith('#'):
            data = 'dword:%08x' % (int(value[1:]) & 0xffffffff)
        elif '\0' in value:
            data = 'str(7):"{}"'.format(reg_escape('\0'.join(s for s in value.split('\0') if s) + '\0\0'))
        else:
            data = '"{}"'.format(reg_escape(value))
        values['@' if not vname else '"{}"'.format(reg_escape(vname))] = data
    for hive, keys in hives.items():
        reg = os.path.join(cart_dir, '.kazeta/share/registry', hive + '.d', '45-msi-{}.reg'.format(name))
        os.makedirs(os.path.dirname(reg), exist_ok=True)
        with open(reg, 'w', encoding='utf-8') as f:
            f.write(';; from {}\n'.format(os.path.basename(path)))
            for key, values in keys.items():
                f.write('\n[{}] 0\n'.format(reg_escape(key)))
                for v, data in values.items():
                    f.write('{}={}\n'.format(v, data))
    print('{}: {} files, {} registry keys from features {}'.format(
        os.path.basename(path), len(files), sum(len(k) for k in hives.values()), ' '.join(chosen)))


try:
    with open('contentdb.yaml') as yaml_file:
        games = yaml.load(yaml_file, Loader=yaml.FullLoader)

except:
    print('ERROR: Failed to load game database')

if len(sys.argv) < 2:
    for game in games:
        if game.get('kind') == 'runtime':
            print('{} | {}'.format(game['name'], game['id']))
        else:
            print('{} | {}:{}:{}'.format(game['name'], game['id'], game['provider'], game['platform']))

    sys.exit()

entry_id = sys.argv[1]
args = entry_id.split(':')
game_id = args[0]
provider = '.*'
platform = '.*'

if len(args) >= 2:
    provider = args[1]

if len(args) >= 3:
    platform = args[1]

results = []
for g in games:
    if g['id'] == game_id and re.match(provider, g.get('provider', '')) and re.match(platform, g.get('platform', '')):
        results.append(g)

if len(results) == 0:
    print('ERROR: \'{}\' not found'.format(entry_id))
    sys.exit(1)

if len(results) > 1:
    print('ERROR: Matched more than one entry, please include the provider and/or the platform, e.g. game-name:steam:linux')
    sys.exit(1)

game = results[0]

# `base: <id>`: the recipe is another one's (e.g. a runtime's next version) with its own keys
# replacing the base's, except `sources` and `post`, which come after the base's (each `post` runs
# on its own, from the cart directory). The name, id and hash stay the recipe's own
def with_base(game, seen):
    if 'base' not in game:
        return dict(game, post=[game['post']] if 'post' in game else [])
    if game['base'] in seen:
        print('ERROR: base: \'{}\' is its own base'.format(game['base']))
        sys.exit(1)
    bases = [g for g in games if g['id'] == game['base']]
    if len(bases) != 1:
        print('ERROR: base: \'{}\' must match one entry'.format(game['base']))
        sys.exit(1)
    base = with_base(bases[0], seen + (game['base'],))
    merged = {k: v for k, v in base.items() if k not in ('name', 'id', 'xxh3sum')}
    merged.update({k: v for k, v in game.items() if k != 'base'})
    merged['sources'] = base.get('sources', []) + game.get('sources', [])
    merged['post'] = base['post'] + ([game['post']] if 'post' in game else [])
    return merged

game = with_base(game, (game['id'],))

dst_dir = game['id']
download_dir = dst_dir + '_download'
staging_dir = dst_dir + '_staging'

subprocess.run(["rm", "-rf", dst_dir])
subprocess.run(["mkdir", dst_dir])

# a runtime can be made entirely in `post` (the none runtime)
if 'sources' not in game and game.get('kind') != 'runtime':
    print('No sources found, exiting')
    sys.exit(1)

for source in game.get('sources', []):
    # a file written from the recipe itself (launch scripts, configs), instead of `post` heredocs
    if source.get('type') == 'inline':
        if 'content' not in source or 'destination' not in source or source['destination'].endswith('/'):
            print("ERROR: 'inline' sources need 'content' and a file 'destination'")
            sys.exit(1)
        text_dst = os.path.join(dst_dir, source['destination'])
        os.makedirs(os.path.dirname(text_dst), exist_ok=True)
        with open(text_dst, 'w', encoding='utf-8', newline='') as f:
            f.write(source['content'])
        os.chmod(text_dst, 0o755 if source.get('executable') else 0o644)
        continue

    if 'uri' not in source:
        print('Missing `uri` key in source')
        sys.exit(1)

    uri = source['uri']
    subprocess.run(["rm", "-rf", download_dir])
    subprocess.run(["rm", "-rf", staging_dir])
    subprocess.run(["mkdir", download_dir])
    subprocess.run(["mkdir", staging_dir])

    # find/fetch files
    basename = os.path.basename(uri)
    if uri.startswith('file://'):
        path = os.path.join(FILE_DIR, basename)
    elif uri.startswith('steam://'):
        path = os.path.join(STEAM_DIR, basename)
    elif uri.startswith('epic://'):
        path = os.path.join(HEROIC_DIR, basename)
    elif uri.startswith('amazon://'):
        path = os.path.join(HEROIC_DIR, basename)
    elif uri.startswith('https://') or uri.startswith('http://'):
        subprocess.run(["curl", "--progress-bar", "-LO", "--output-dir", download_dir,  uri])
        path = os.path.join(download_dir, basename)

        # allow execution of app images
        if path.endswith('.AppImage'):
            subprocess.run(["chmod", "+x", path])
    else:
        print('Unknown URI: {}'.format(uri))
        sys.exit(1)

    if not os.path.exists(path):
        print("ERROR: File or directory not found: {}".format(basename))
        sys.exit(1)

    if 'executable' in source and source['executable'] == True and os.path.isfile(path):
        subprocess.run(["chmod", "+x", path])

    # check hash
    if 'xxh3sum' in source and os.path.isfile(path):
        if not xxh3_check(path, source['xxh3sum']):
            sys.exit(1)

    if 'process' in source and source['process'] == False:
        continue

    if 'type' in source:
        filetype = source['type']
    elif path.endswith('.tar') or '.tar.' in path:
        filetype = 'tar'
    elif path.endswith('.zip') or path.endswith('.sh') or path.endswith('-bin'):
        filetype = 'zip'
    elif path.endswith('.7z'):
        filetype = '7z'
    elif path.endswith('.msi'):
        filetype = 'msi'
    elif path.endswith('.exe'):
        filetype = 'inno'
    elif path.endswith('.ico'):
        filetype = 'icon'
    elif os.path.isdir(path):
        filetype = 'dir'
    else:
        filetype = 'plain'

    match filetype:
        case 'tar':
            subprocess.run(["tar", "-xf", path, "-C", staging_dir])
        case 'zip':
            subprocess.run(["unzip", "-q", path, "-d", staging_dir])
        case '7z':
            subprocess.run(["7z", "x", "-y", "-bso0", "-bsp0", "-o" + staging_dir, path])
        case 'hfs':
            extract_hfs(path, staging_dir)
        case 'inno':
            subprocess.run(["innoextract", "--silent", "--progress=1", path, "-d", staging_dir])
        case 'msi':
            # installed into the prefix and the cart's registry; `include` names the MSI in a
            # directory source (steam://), destination doesn't apply
            msi = os.path.join(path, source['include']) if os.path.isdir(path) else path
            install_msi(msi, source, dst_dir, staging_dir, game.setdefault('env', {}))
            continue
        case 'icon':
            if 'include' not in source or 'destination' not in source:
                print("ERROR: Provide 'include' and 'destination' fields for 'icon' type sources or set type to 'plain'")
                sys.exit(1)

            subprocess.run(["magick", path + '[' + str(source['include']) + ']', "-strip",  os.path.join(dst_dir, source['destination'])])
            continue
        case 'dir':
            src_files = glob.glob(path + '/*')
            for f in src_files:
                subprocess.run(["cp", "-r", f, staging_dir + '/'])
        case 'plain':
            subprocess.run(["cp", path, staging_dir + '/'])
        case 'blizzard-install' | 'bnupdate':
            # these work on the files already in the cart (or in `destination`), like
            # Blizzard's installers: Brood War installs over StarCraft, patches patch it
            command = 'install' if filetype == 'blizzard-install' else 'patch'
            target_dir = os.path.join(dst_dir, source.get('destination', ''))
            if subprocess.run([blizzard_path(), command, path, target_dir]).returncode != 0:
                sys.exit(1)
            continue
        case _:
            print("ERROR: Unknown file type for file: \"{}\"\nFile type must be one of: 'tar', 'zip', '7z', 'inno', 'hfs', 'msi', 'icon', 'dir', 'plain', 'inline', 'blizzard-install', 'bnupdate'".format(os.path.basename(path)))
            sys.exit(1)

    # exclude filter
    if 'exclude' in source:
        excludes = source['exclude']
        if not isinstance(excludes, list):
            excludes = [ excludes ]

        for e in excludes:
            files = glob.glob(os.path.join(staging_dir, e))
            for f in files:
                subprocess.run(["rm", "-rf", f])

    final_dst = dst_dir
    if 'destination' in source:
        final_dst = os.path.join(dst_dir, source['destination'])

    # include filter - include all remaining files by default
    includes = '*'
    if 'include' in source:
        includes = source['include']

    if not isinstance(includes, list):
        includes = [ includes ]

    for e in includes:
        src_files = glob.glob(os.path.join(staging_dir, e))
        for f in src_files:
            final_basedir = os.path.dirname(final_dst)
            if final_basedir:
                subprocess.run(["mkdir", "-p", final_basedir])
            subprocess.run(["mv", f, final_dst])


# clean up
subprocess.run(["rm", "-rf", download_dir])
subprocess.run(["rm", "-rf", staging_dir])

# runtimes (.kzr) are the base layer carts run on, without a cart's metadata
is_runtime = game.get('kind') == 'runtime'

if not is_runtime:
    icon_path=os.path.join(game['id'], 'org.kazeta.icon.png')
    if not os.path.exists(icon_path):
        print("WARNING: no icon found")

    with open(os.path.join(game['id'], 'org.kazeta.cart.kzi'), 'w', encoding='utf-8') as file:
        file.write('Name={}\n'.format(game['name']))
        file.write('Id={}\n'.format(game['id']))
        file.write('Exec={}\n'.format(game['exec']))
        file.write('Icon={}\n'.format('org.kazeta.icon.png'))
        if 'path' in game:
            file.write('Path={}\n'.format(game['path']))
        if 'gamescope' in game:
            file.write('GamescopeOptions={}\n'.format(game['gamescope']))
        if 'runtime' in game and game['runtime'] != 'none':
            file.write('Runtime={}\n'.format(game['runtime']))
        # one Env line per variable, set by the runtime for the game (Linux) or Proton (Windows)
        for name, value in game.get('env', {}).items():
            if isinstance(value, bool):
                sys.exit("env {}: quote the value, YAML reads {} as a boolean".format(name, value))
            if '\n' in str(value) or '=' in str(name):
                sys.exit("env {}: names can't contain '=', values can't contain newlines".format(name))
            file.write('Env={}={}\n'.format(name, value))

if 'steam_app_id' in game:
    with open(os.path.join(game['id'], 'steam_appid.txt'), 'w', encoding='utf-8') as file:
        file.write(str(game['steam_app_id']))

# INI settings, {file: {section: {key: value}}}, applied before `post`: an existing key's first line in
# the section gets the value, a missing key is added at the end of its section, a missing section at
# the end of the file. Line endings stay as the file has them
def set_ini(path, settings):
    with open(path, 'rb') as f:
        data = f.read()
    if data.startswith(b'\xff\xfe') or data.startswith(b'\xfe\xff'):
        print("ERROR: ini: {} is UTF-16, which isn't supported".format(path))
        sys.exit(1)
    text = data.decode('latin-1') # bytes as they are
    nl = '\r\n' if '\r\n' in text else '\n'
    lines = text.split(nl)
    for section, values in settings.items():
        for key, value in values.items():
            value = str(value)
            start = next((i for i, l in enumerate(lines) if l.strip().lower() == '[{}]'.format(section).lower()), None)
            if start is None:
                trailing = bool(lines) and lines[-1] == '' # the file ends with a newline
                if trailing:
                    lines.pop()
                lines.append('[{}]'.format(section))
                start = len(lines) - 1
                if trailing:
                    lines.append('')
            end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
            match = next((i for i in range(start + 1, end) if lines[i].split('=', 1)[0].strip().lower() == str(key).lower() and '=' in lines[i]), None)
            if match is not None:
                lines[match] = '{}={}'.format(lines[match].split('=', 1)[0], value)
            else:
                last = max([i for i in range(start, end) if lines[i].strip()] or [start])
                lines.insert(last + 1, '{}={}'.format(key, value))
    with open(path, 'wb') as f:
        f.write(nl.join(lines).encode('latin-1'))

for name, settings in game.get('ini', {}).items():
    target = os.path.join(dst_dir, name)
    if not os.path.isfile(target):
        print("ERROR: ini: {} not found".format(name))
        sys.exit(1)
    set_ini(target, settings)

# byte patches, {file: ["offset original-bytes new-bytes", ...]} (hex), applied before `post`; the
# original bytes are checked first, so a different version of the file stops the build
for name, patches in game.get('patches', {}).items():
    target = os.path.join(dst_dir, name)
    if not os.path.isfile(target):
        print("ERROR: patches: {} not found".format(name))
        sys.exit(1)
    with open(target, 'r+b') as file:
        for patch in patches:
            fields = str(patch).split()
            try:
                offset, original, new = int(fields[0], 0), bytes.fromhex(fields[1]), bytes.fromhex(fields[2])
            except (ValueError, IndexError):
                fields = None
            if not fields or len(fields) != 3 or len(original) != len(new):
                print("ERROR: patches: {}: '{}' isn't 'offset original new' with bytes of the same length".format(name, patch))
                sys.exit(1)
            file.seek(offset)
            if file.read(len(original)) != original:
                print("ERROR: patches: {}: unexpected bytes at {}".format(name, fields[0]))
                sys.exit(1)
            file.seek(offset)
            file.write(new)

for post in game['post']: # the base recipes' first (see `base`)
    with open('/tmp/kazeta-creator-script', 'w', encoding='utf-8') as file:
        file.write('#! /bin/bash\n')
        file.write(str(post))
    subprocess.run(['chmod', '+x', '/tmp/kazeta-creator-script'])
    env = os.environ
    if re.search(r'\bblizzard\b', str(post)):
        # make the tool available to post scripts as `blizzard`
        env = env | {'PATH': os.path.dirname(blizzard_path()) + os.pathsep + env.get('PATH', '')}
    subprocess.run(['/tmp/kazeta-creator-script'], cwd=game['id'], env=env)

if 'tricks' in game and 'runtime' in game and 'windows' in game['runtime']:
    cwd = os.getcwd()
    runtime = os.path.join(cwd, game['runtime'] + '.kzr')

    if not Path(runtime).is_file():
        print("ERROR: Runtime file required to run winetricks, but not found at: {}".format(runtime))
        sys.exit(1)

    gamedir = os.path.join(cwd, game['id'])
    workdir = os.path.join(cwd, '.run/work')
    targetdir = os.path.join(cwd, '.run/target')
    runtimedir = os.path.join(cwd, '.run/runtime')

    # mount game data as an overlay on top of the runtime
    subprocess.run(["pkexec", "kazeta-mount", "install", gamedir, workdir, targetdir, runtime, runtimedir])

    try:
        # perform winetricks on targetdir; Proton 11 has no separate wine64
        wine = os.path.join(targetdir, '.kazeta/share/proton/files/bin/wine64')
        if not os.path.exists(wine):
            wine = os.path.join(targetdir, '.kazeta/share/proton/files/bin/wine')
        prefix = os.path.join(targetdir, '.kazeta/var/prefix')
        # windows-2.0's prefix links dosdevices to /tmp/kazeta-dosdevices, which its `run` fills at
        # each launch; without this, C: would be the drive of the last cart Kazeta ran
        dosdevices = '/tmp/kazeta-dosdevices'
        if os.path.islink(os.path.join(prefix, 'dosdevices')):
            subprocess.run(["rm", "-rf", dosdevices])
            os.makedirs(dosdevices)
            os.symlink(os.path.join(prefix, 'drive_c'), os.path.join(dosdevices, 'c:'))
            os.symlink('/', os.path.join(dosdevices, 'z:'))
        # windows-3.0 links the user's Temp to /tmp/kazeta-temp, which its `run` makes
        if os.path.islink(os.path.join(prefix, 'drive_c/users/steamuser/AppData/Local/Temp')):
            os.makedirs('/tmp/kazeta-temp', exist_ok=True)
        env = os.environ | {"WINE": wine, "WINEPREFIX": prefix}
        # runtimes with a layered registry (windows-3.0) merge it at launch: give winetricks the
        # runtime's and the cart's layers, then keep what it changed as a layer of the cart
        regstack = os.path.join(targetdir, '.kazeta/share/regstack')
        hives = ['system.reg', 'user.reg', 'userdef.reg']
        def layers(hive):
            d = os.path.join(targetdir, '.kazeta/share/registry', hive + '.d')
            return sorted(os.path.join(d, f) for f in os.listdir(d) if f.endswith('.reg'))
        if os.path.exists(regstack):
            for hive in hives:
                subprocess.run([regstack, "merge", os.path.join(prefix, hive)] + layers(hive), check=True)
        subprocess.run(["winetricks", "-q"] + game['tricks'].split(' '), env=env)
        # wineserver keeps the overlay busy, and writes the registry when it exits
        wineserver = os.path.join(os.path.dirname(wine), 'wineserver')
        subprocess.run([wineserver, "-w"], env=env)
        if os.path.exists(regstack):
            for hive in hives:
                out = os.path.join(targetdir, '.kazeta/share/registry', hive + '.d', '40-tricks.reg')
                subprocess.run([regstack, "diff", os.path.join(prefix, hive), out] + layers(hive), check=True)
                os.remove(os.path.join(prefix, hive))
    finally:
        # unmount overlay and runtime
        subprocess.run(["pkexec", "kazeta-mount", "--unmount", targetdir, runtimedir])

# create kzp (or kzr)
kzp = game['id'] + ('.kzr' if is_runtime else '.kzp')
subprocess.run(["rm", "-rf", kzp])
uuid=str(uuid.uuid5(uuid.NAMESPACE_DNS, 'org.kazeta.' + game['id']))
timestamp = '0'
if 'timestamp' in game:
    timestamp = str(game['timestamp'])
tmp_dir = game['id'] + '_tmp' # mkfs.erofs buffers data in TMPDIR; /tmp may be too small for large games
subprocess.run(["rm", "-rf", tmp_dir])
subprocess.run(["mkdir", tmp_dir])
# runtimes repeat a lot of data (Proton ships many DLLs several times); dedupe stores it once
# (needs Linux 6.1+). Not for carts, as it would change their hashes
dedupe = ["-Ededupe"] if is_runtime else []
subprocess.run(["mkfs.erofs", "-T", timestamp, "-U", uuid, "-zlz4"] + dedupe + [kzp, game['id']],
               env={**os.environ, 'TMPDIR': os.path.abspath(tmp_dir)})
subprocess.run(["rm", "-rf", tmp_dir, game['id']])

if 'xxh3sum' in game:
    if xxh3_check(kzp, game['xxh3sum']):
        print("OK: xxh3sum matches: {}".format(game['xxh3sum']))
else:
    print("WARNING: recipe has no xxh3sum; build not verified: {}".format(xxh3sum(kzp)))

# carts name their runtime, so runtimes keep their plain name
if is_runtime:
    sys.exit()

xxh3 = xxh3sum(kzp)[:5]
final_dst = game['id'] + '_' + xxh3 + '.kzp'
subprocess.run(["mv", kzp, final_dst])
